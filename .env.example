# Firebase Web App configuration for movie-hub-web.
# Copy this file to .env and fill the values from Firebase Console > Project settings > Your apps.
# The normal Firebase web config is client configuration; never place Admin SDK credentials here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=movie-hub-62459
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# TMDB application credential for trusted Node/CI scripts only.
# IMPORTANT: never rename this to VITE_TMDB_* and never import it from browser code.
# Local usage: provide this variable to `npm run tmdb:smoke` via your shell/environment.
TMDB_API_READ_TOKEN=

# Optional discovery depth for the broad provider search index. Movie and
# series limits are independent; TMDB itself exposes at most 500 pages.
TMDB_SEARCH_MOVIE_PAGES_PER_OFFER=50
TMDB_SEARCH_SERIES_PAGES_PER_OFFER=50

# Optional limit and maximum age for the nightly incremental enrichment of
# broad search titles. Existing enriched shards are restored before the run;
# incomplete titles are processed first, followed by the oldest stale details.
TMDB_SEARCH_DETAIL_ENRICH_LIMIT=800
TMDB_SEARCH_DETAIL_MAX_AGE_DAYS=30

# Trusted CI/backend maintenance for the personal Movie-Hub provider catalog.
MOVIE_HUB_METADATA_BACKFILL_LIMIT=250
MOVIE_HUB_METADATA_MAX_AGE_DAYS=30
