{
  "name": "movie-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.js\"",
    "test:tmdb": "vitest run tests/tmdb.test.js",
    "test:catalog": "vitest run tests/catalog-generator.test.js",
    "test:library": "vitest run tests/library.test.js",
    "tmdb:smoke": "node scripts/tmdb-smoke-test.mjs",
    "tmdb:catalog": "node scripts/generate-tmdb-catalog.mjs && node scripts/generate-search-index.mjs && node scripts/generate-series-details.mjs",
    "search:index": "node scripts/generate-search-index.mjs",
    "search:details": "node scripts/generate-search-details.mjs",
    "search:details:restore": "node scripts/restore-live-search-details.mjs",
    "series:details": "node scripts/generate-series-details.mjs",
    "series:details:restore": "node scripts/restore-live-series-details.mjs",
    "data:status": "node scripts/report-data-status.mjs",
    "epg:quality": "node scripts/free-epg-quality.mjs",
    "test:epg": "vitest run tests/free-epg-quality.test.js",
    "waipu:probe": "node scripts/waipu-public-contract-probe.mjs",
    "waipu:account:probe": "node scripts/waipu-account-probe.mjs",
    "test:waipu": "vitest run tests/waipu-account-probe.test.js tests/waipu-public-contract.test.js tests/waipu-public-data.test.js",
    "test:waipu:public": "vitest run tests/waipu-public-contract.test.js tests/waipu-public-data.test.js",
    "moviehub:presence:migrate": "node scripts/migrate-shared-media-presence.mjs",
    "moviehub:metadata:backfill": "node scripts/enrich-shared-media-metadata.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "firebase": "^11.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.6.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "saxes": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
