rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Das Kontodokument selbst bleibt ausschließlich für die eigene UID.
      allow read, write: if ownsUserData(userId);

      // Interne Movie-Hub-Profile und alle später darunter liegenden
      // persönlichen Zustände (Watchlist, Bewertungen usw.) sind strikt an
      // die authentifizierte Firebase-UID gebunden.
      match /profiles/{profileId} {
        allow read, write: if ownsUserData(userId);

        match /{document=**} {
          allow read, write: if ownsUserData(userId);
        }
      }

      // Bestehende technische Diagnosepfade bleiben für Phase-0-/Regeltests
      // verfügbar, aber ebenfalls nur innerhalb der eigenen UID.
      match /diagnostics/{document=**} {
        allow read, write: if ownsUserData(userId);
      }

      // Gemeinsame Medien sind kontoweit (nicht profilbezogen), damit jeder
      // Eintrag in allen Movie-Hub-Profilen sichtbar und pflegbar ist.
      match /sharedMedia/{document=**} {
        allow read, write: if ownsUserData(userId);
      }

      // Der persönliche TMDB-Katalog ist wie die geräteweite TMDB-Verbindung
      // kontoweit und damit für alle internen Movie-Hub-Profile identisch. Es
      // dürfen ausschließlich nicht geheime Katalogfelder gespeichert werden.
      match /tmdbCatalog/{titleId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasOnly([
            'tmdbId', 'mediaType', 'title', 'originalTitle', 'description',
            'releaseDate', 'posterPath', 'backdropPath', 'originalLanguage',
            'voteAverage', 'voteCount', 'genreNames', 'providerIds', 'ageRating',
            'favorite', 'watchlist', 'rated', 'ratingValue',
            'favoriteOrder', 'watchlistOrder', 'ratingOrder', 'syncedAt'
          ]);
      }

      // Synchronisationsmetadaten enthalten ebenfalls keine Secrets, sondern
      // nur Account-Anzeigeinformationen, Zähler und Zeitpunkt.
      match /tmdbSync/{documentId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasOnly([
            'syncedAt', 'accountId', 'accountUsername', 'accountName',
            'favoriteCount', 'watchlistCount', 'ratingCount', 'totalCount'
          ]);
      }
    }

    // Öffentliche Katalogdaten dürfen gelesen, aber niemals direkt vom Client
    // verändert werden. Schreibzugriffe erfolgen ausschließlich über
    // vertrauenswürdige Build-/Backend-Prozesse.
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
